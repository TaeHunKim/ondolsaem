<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Merged into every client app: lets it see and bind to the OndolSaem host (Android 11+ package visibility). -->
    <queries>
        <package android:name="io.github.taehunkim.ondolsaem" />
    </queries>
    <application>
        <!-- Model-change hints from the host; exported because the host is another app. -->
        <receiver
            android:name="io.github.taehunkim.ondolsaem.sdk.ModelChangedReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="io.github.taehunkim.ondolsaem.action.MODEL_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
